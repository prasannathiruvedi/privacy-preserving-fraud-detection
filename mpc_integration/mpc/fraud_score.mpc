# fraud_score.mpc
#
# Secure fraud-risk scoring for ONE UPI transaction, run fresh per
# transaction by mpc_integration/main.py (which templates in the
# GATEWAY_* constants below before handing this file to compile.py).
#
# Do not edit the numeric constants by hand — they're generated from
# mpc_integration/model_constants.py by render_mpc_script.py. Structural
# changes (new features, different party layout) should be made to the
# template in render_mpc_script.py, not here.
#
# --------------------------------------------------------------------
# PARTY LAYOUT (fixed per run by the orchestrator — NOT fixed to a bank)
# --------------------------------------------------------------------
# Whichever institution is the SENDER for this specific transaction is
# started as player 0, whichever is the RECEIVER as player 1 — SBI and
# HDFC swap which slot they fill depending on the transaction, which is
# why the model's "sender_*"/"receiver_*" features are ROLE-based, not
# bank-based. NPCI is always player 2.
#
#   Player 0 (sender bank)   -> SENDER_INPUTS   secret values, in order
#   Player 1 (receiver bank) -> RECEIVER_INPUTS  secret values, in order
#   Player 2 (NPCI)          -> NPCI_INPUTS      secret values, in order
#
# --------------------------------------------------------------------
# WHY GATEWAY FEATURES ARE PUBLIC, NOT SECRET-SHARED
# --------------------------------------------------------------------
# hour/day_of_week/amount/device/ip/bank-id/merchant are all visible to
# the gateway already as the entry point of the transaction, and none of
# them are private BETWEEN the three compute parties (SBI, HDFC and NPCI
# all already see who's paying whom, when, and how much, in real UPI).
# So instead of spending a secret-input slot on them, mpc_integration/
# main.py regenerates this file per transaction with these baked in as
# plain compile-time constants. If that assumption ever stops holding,
# swap these to sfix.get_input_from(2) inputs instead (NPCI carrying
# them alongside its own features).
#
# --------------------------------------------------------------------
# WHY NO SIGMOID
# --------------------------------------------------------------------
# sigmoid is monotonic increasing, so sigmoid(logit) >= threshold is
# exactly equivalent to logit >= LOGIT_THRESHOLD, where LOGIT_THRESHOLD
# = ln(threshold / (1 - threshold)) is computed once, offline, in
# Python (see model_constants.py). That turns "compute a probability
# and compare it" into a single fixed-point comparison — no exp(), no
# division just to get a yes/no decision. The continuous logit is also
# revealed so the orchestrator can log a risk trend, not just a flag.
#
# --------------------------------------------------------------------
# WHY StandardScaler DISAPPEARS
# --------------------------------------------------------------------
# The trained model's coef_/scaler mean_/scale_ are folded together
# offline into FOLDED_WEIGHTS / FOLDED_BIAS (see model_constants.py's
# docstring for the algebra). That means this script does ONE dot
# product over raw feature values — no per-feature (x - mean) / scale
# division under MPC, which would otherwise be by far the most
# expensive part of the whole computation.

from Compiler.types import sfix, cfix

sfix.set_precision(16, 48)
cfix.set_precision(16, 48)

# ============================================================
# Gateway-owned features — PUBLIC, templated in per transaction
# ============================================================
HOUR                = cfix(__HOUR__)
DAY_OF_WEEK         = cfix(__DAY_OF_WEEK__)
IS_WEEKEND          = cfix(__IS_WEEKEND__)
IS_NIGHT            = cfix(__IS_NIGHT__)
LOG_AMOUNT          = cfix(__LOG_AMOUNT__)
AMOUNT              = cfix(__AMOUNT__)            # raw amount, needed only for amount_vs_avg_ratio below
IS_LARGE_TXN        = cfix(__IS_LARGE_TXN__)
IS_ROUND_AMOUNT     = cfix(__IS_ROUND_AMOUNT__)
IS_NEW_DEVICE       = cfix(__IS_NEW_DEVICE__)
DEVICE_CHANGE_30D   = cfix(__DEVICE_CHANGE_30D__)
DEVICE_CHANGE_RISK  = cfix(__DEVICE_CHANGE_RISK__)
FOREIGN_IP          = cfix(__FOREIGN_IP__)
SENDER_BANK         = cfix(__SENDER_BANK__)        # label-encoded ints, see model_constants.ENCODER_CLASSES
RECEIVER_BANK       = cfix(__RECEIVER_BANK__)
MERCHANT_CATEGORY   = cfix(__MERCHANT_CATEGORY__)
IP_COUNTRY          = cfix(__IP_COUNTRY__)

# ============================================================
# Sender-bank secret inputs (player 0)
# ============================================================
sender_account_age_days = sfix.get_input_from(0)
sender_txn_count_7d     = sfix.get_input_from(0)
sender_avg_amount_30d   = sfix.get_input_from(0)
high_sender_velocity    = sfix.get_input_from(0)
sender_upi_app          = sfix.get_input_from(0)
sender_state            = sfix.get_input_from(0)
is_new_beneficiary      = sfix.get_input_from(0)
is_new_sender_acc       = sfix.get_input_from(0)

# ============================================================
# Receiver-bank secret inputs (player 1)
# ============================================================
receiver_account_age_days = sfix.get_input_from(1)
receiver_txn_count_7d     = sfix.get_input_from(1)
receiver_upi_app          = sfix.get_input_from(1)
receiver_state             = sfix.get_input_from(1)
is_new_receiver_acc        = sfix.get_input_from(1)

# ============================================================
# NPCI secret inputs (player 2)
# ============================================================
failed_attempts_24h  = sfix.get_input_from(2)
failed_attempt_risk  = sfix.get_input_from(2)

# ============================================================
# Derived features — computed INSIDE the circuit because each one
# needs raw values from more than one party. No single party sees
# the other side's number, only the folded contribution to the
# final logit.
# ============================================================

# amount_vs_avg_ratio = amount / (sender_avg_amount_30d + 1)
# AMOUNT is public; sender_avg_amount_30d is secret — this is the
# one real "division involving a secret" in the whole script.
amount_vs_avg_ratio = AMOUNT / (sender_avg_amount_30d + 1)

# account_age_diff = abs(sender_account_age_days - receiver_account_age_days)
_age_diff = sender_account_age_days - receiver_account_age_days
_age_diff_is_negative = (_age_diff < 0)
account_age_diff = _age_diff_is_negative.if_else(-_age_diff, _age_diff)

# txn_velocity_ratio = sender_txn_count_7d / (receiver_txn_count_7d + 1)
txn_velocity_ratio = sender_txn_count_7d / (receiver_txn_count_7d + 1)

# cross_state = 1 if sender_state != receiver_state else 0
# Both are exact integers even in fixed-point representation (label
# encodings), so equality comparison here is exact, not approximate.
cross_state = (sender_state == receiver_state).if_else(sfix(0), sfix(1))

# multi_risk_flag = count of risk booleans set, across all three parties
multi_risk_flag = (
    IS_NEW_DEVICE + is_new_beneficiary + FOREIGN_IP
    + is_new_sender_acc + is_new_receiver_acc
)

# ============================================================
# Folded weights (StandardScaler + LogisticRegression collapsed —
# see model_constants.py). One multiply-accumulate per feature.
# ============================================================
__WEIGHT_DECLS__

logit = __FOLDED_BIAS__
logit = logit + W_HOUR * HOUR
logit = logit + W_DAY_OF_WEEK * DAY_OF_WEEK
logit = logit + W_IS_WEEKEND * IS_WEEKEND
logit = logit + W_IS_NIGHT * IS_NIGHT
logit = logit + W_LOG_AMOUNT * LOG_AMOUNT
logit = logit + W_AMOUNT_VS_AVG_RATIO * amount_vs_avg_ratio
logit = logit + W_IS_LARGE_TXN * IS_LARGE_TXN
logit = logit + W_IS_ROUND_AMOUNT * IS_ROUND_AMOUNT
logit = logit + W_SENDER_ACCOUNT_AGE_DAYS * sender_account_age_days
logit = logit + W_RECEIVER_ACCOUNT_AGE_DAYS * receiver_account_age_days
logit = logit + W_IS_NEW_SENDER_ACC * is_new_sender_acc
logit = logit + W_IS_NEW_RECEIVER_ACC * is_new_receiver_acc
logit = logit + W_ACCOUNT_AGE_DIFF * account_age_diff
logit = logit + W_SENDER_TXN_COUNT_7D * sender_txn_count_7d
logit = logit + W_RECEIVER_TXN_COUNT_7D * receiver_txn_count_7d
logit = logit + W_TXN_VELOCITY_RATIO * txn_velocity_ratio
logit = logit + W_HIGH_SENDER_VELOCITY * high_sender_velocity
logit = logit + W_SENDER_AVG_AMOUNT_30D * sender_avg_amount_30d
logit = logit + W_IS_NEW_DEVICE * IS_NEW_DEVICE
logit = logit + W_IS_NEW_BENEFICIARY * is_new_beneficiary
logit = logit + W_FAILED_ATTEMPTS_24H * failed_attempts_24h
logit = logit + W_FAILED_ATTEMPT_RISK * failed_attempt_risk
logit = logit + W_DEVICE_CHANGE_30D * DEVICE_CHANGE_30D
logit = logit + W_DEVICE_CHANGE_RISK * DEVICE_CHANGE_RISK
logit = logit + W_CROSS_STATE * cross_state
logit = logit + W_FOREIGN_IP * FOREIGN_IP
logit = logit + W_MULTI_RISK_FLAG * multi_risk_flag
logit = logit + W_SENDER_UPI_APP * sender_upi_app
logit = logit + W_RECEIVER_UPI_APP * receiver_upi_app
logit = logit + W_SENDER_BANK * SENDER_BANK
logit = logit + W_RECEIVER_BANK * RECEIVER_BANK
logit = logit + W_MERCHANT_CATEGORY * MERCHANT_CATEGORY
logit = logit + W_SENDER_STATE * sender_state
logit = logit + W_RECEIVER_STATE * receiver_state
logit = logit + W_IP_COUNTRY * IP_COUNTRY

# ============================================================
# Decision — logit-threshold trick, no sigmoid needed
# ============================================================
decision = (logit >= __LOGIT_THRESHOLD__)

print_ln('RISK_LOGIT:%s', logit.reveal())
print_ln('RISK_DECISION:%s', decision.reveal())
