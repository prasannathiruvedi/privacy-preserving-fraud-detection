
from Compiler.types import sfix, cfix

sfix.set_precision(16, 48)
cfix.set_precision(16, 48)

HOUR                = cfix(__HOUR__)
DAY_OF_WEEK         = cfix(__DAY_OF_WEEK__)
IS_WEEKEND          = cfix(__IS_WEEKEND__)
IS_NIGHT            = cfix(__IS_NIGHT__)
LOG_AMOUNT          = cfix(__LOG_AMOUNT__)
AMOUNT              = cfix(__AMOUNT__)
IS_LARGE_TXN        = cfix(__IS_LARGE_TXN__)
IS_ROUND_AMOUNT     = cfix(__IS_ROUND_AMOUNT__)
IS_NEW_DEVICE       = cfix(__IS_NEW_DEVICE__)
DEVICE_CHANGE_30D   = cfix(__DEVICE_CHANGE_30D__)
DEVICE_CHANGE_RISK  = cfix(__DEVICE_CHANGE_RISK__)
FOREIGN_IP          = cfix(__FOREIGN_IP__)
SENDER_BANK         = cfix(__SENDER_BANK__)
RECEIVER_BANK       = cfix(__RECEIVER_BANK__)
MERCHANT_CATEGORY   = cfix(__MERCHANT_CATEGORY__)
IP_COUNTRY          = cfix(__IP_COUNTRY__)

sender_account_age_days = sfix.get_input_from(0)
sender_txn_count_7d     = sfix.get_input_from(0)
sender_avg_amount_30d   = sfix.get_input_from(0)
high_sender_velocity    = sfix.get_input_from(0)
sender_upi_app          = sfix.get_input_from(0)
sender_state            = sfix.get_input_from(0)
is_new_beneficiary      = sfix.get_input_from(0)
is_new_sender_acc       = sfix.get_input_from(0)

receiver_account_age_days = sfix.get_input_from(1)
receiver_txn_count_7d     = sfix.get_input_from(1)
receiver_upi_app          = sfix.get_input_from(1)
receiver_state             = sfix.get_input_from(1)
is_new_receiver_acc        = sfix.get_input_from(1)

failed_attempts_24h  = sfix.get_input_from(2)
failed_attempt_risk  = sfix.get_input_from(2)

amount_vs_avg_ratio = AMOUNT / (sender_avg_amount_30d + 1)

_age_diff = sender_account_age_days - receiver_account_age_days
_age_diff_is_negative = (_age_diff < 0)
account_age_diff = _age_diff_is_negative.if_else(-_age_diff, _age_diff)

txn_velocity_ratio = sender_txn_count_7d / (receiver_txn_count_7d + 1)

cross_state = (sender_state == receiver_state).if_else(sfix(0), sfix(1))

multi_risk_flag = (
    IS_NEW_DEVICE + is_new_beneficiary + FOREIGN_IP
    + is_new_sender_acc + is_new_receiver_acc
)

__WEIGHT_DECLS__

logit = __FOLDED_BIAS__
logit = logit + W_HOUR * HOUR
logit = logit + W_DAY_OF_WEEK * DAY_OF_WEEK
logit = logit + W_IS_WEEKEND * IS_WEEKEND
logit = logit + W_IS_NIGHT * IS_NIGHT
logit = logit + W_LOG_AMOUNT * LOG_AMOUNT
logit = logit + W_AMOUNT_VS_AVG_RATIO * amount_vs_avg_ratio
logit = logit + W_IS_LARGE_TXN * IS_LARGE_TXN
logit = logit + W_IS_ROUND_AMOUNT * IS_ROUND_AMOUNT
logit = logit + W_SENDER_ACCOUNT_AGE_DAYS * sender_account_age_days
logit = logit + W_RECEIVER_ACCOUNT_AGE_DAYS * receiver_account_age_days
logit = logit + W_IS_NEW_SENDER_ACC * is_new_sender_acc
logit = logit + W_IS_NEW_RECEIVER_ACC * is_new_receiver_acc
logit = logit + W_ACCOUNT_AGE_DIFF * account_age_diff
logit = logit + W_SENDER_TXN_COUNT_7D * sender_txn_count_7d
logit = logit + W_RECEIVER_TXN_COUNT_7D * receiver_txn_count_7d
logit = logit + W_TXN_VELOCITY_RATIO * txn_velocity_ratio
logit = logit + W_HIGH_SENDER_VELOCITY * high_sender_velocity
logit = logit + W_SENDER_AVG_AMOUNT_30D * sender_avg_amount_30d
logit = logit + W_IS_NEW_DEVICE * IS_NEW_DEVICE
logit = logit + W_IS_NEW_BENEFICIARY * is_new_beneficiary
logit = logit + W_FAILED_ATTEMPTS_24H * failed_attempts_24h
logit = logit + W_FAILED_ATTEMPT_RISK * failed_attempt_risk
logit = logit + W_DEVICE_CHANGE_30D * DEVICE_CHANGE_30D
logit = logit + W_DEVICE_CHANGE_RISK * DEVICE_CHANGE_RISK
logit = logit + W_CROSS_STATE * cross_state
logit = logit + W_FOREIGN_IP * FOREIGN_IP
logit = logit + W_MULTI_RISK_FLAG * multi_risk_flag
logit = logit + W_SENDER_UPI_APP * sender_upi_app
logit = logit + W_RECEIVER_UPI_APP * receiver_upi_app
logit = logit + W_SENDER_BANK * SENDER_BANK
logit = logit + W_RECEIVER_BANK * RECEIVER_BANK
logit = logit + W_MERCHANT_CATEGORY * MERCHANT_CATEGORY
logit = logit + W_SENDER_STATE * sender_state
logit = logit + W_RECEIVER_STATE * receiver_state
logit = logit + W_IP_COUNTRY * IP_COUNTRY

decision = (logit >= __LOGIT_THRESHOLD__)

print_ln('RISK_LOGIT:%s', logit.reveal())
print_ln('RISK_DECISION:%s', decision.reveal())
